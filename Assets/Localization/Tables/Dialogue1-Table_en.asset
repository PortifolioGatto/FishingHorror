  m_TableData:
  - m_Id: 22276931584
    m_Localized: "Uncle\t"
    m_Metadata:
      m_Items: []
  - m_Id: 78077952000
    m_Localized: "Welcome to the \u201CVocatio Abyssi\u201D, Hugo! This is where
      we\u2019re gonna get rich, kid"
    m_Metadata:
      m_Items: []
  - m_Id: 1503105318912
    m_Localized: "Like I told you, fish from all over the world show up here every
      8 years. Weird, right? It\u2019s like the usual habitat rules just don\u2019t
      exist here."
    m_Metadata:
      m_Items: []
  - m_Id: 1580305678336
    m_Localized: "Today\u2019s the last day, so we won\u2019t be running into anyone
      else out here."
    m_Metadata:
      m_Items: []
  - m_Id: 1620063485952
    m_Localized: "Alright, let\u2019s go over the basics. Your boat came equipped
      with a sonar. It\u2019ll help you locate the nearest fish, just head over and
      grab \u2019em. Doesn\u2019t matter what you catch. If it\u2019s worth money,
      bring it back."
    m_Metadata:
      m_Items: []
  - m_Id: 1704306081792
    m_Localized: "I\u2019ll be somewhere around here, but everyone sticks to their
      own turf, got it? Your uncle\u2019s trying to make a buck too."
    m_Metadata:
      m_Items: []
  - m_Id: 1751588470784
    m_Localized: "And since you somehow managed to break the microphone on your radio,
      you won\u2019t be able to contact me. But hey, at least I can still bother
      the hell out of you."
    m_Metadata:
      m_Items: []
  - m_Id: 1839069069312
    m_Localized: 'Big expectations, kid. Real big ones.

'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
